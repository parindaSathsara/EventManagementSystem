# =============================================================================
# Stage website — production settings ON THE SERVER.
# deploy/deploy.sh copies this to `.env.production` on the first deploy;
# edit that copy on the server (it is gitignored and survives deploys).
# =============================================================================

# Port the website listens on inside the workspace container.
# 8000 = another app, 8011 = the Stage API. nginx proxies the public domain here.
PORT=8012

# Where the website's server-side proxy (/api/*, /media/*) reaches the API.
# It is fixed INTO each build — after changing it, redeploy (./deploy-web.sh)
# so a fresh build picks it up; a plain pm2 restart is not enough.
# The API runs in the SAME container, so talk to it directly — no round trip
# out through Cloudflare and back. Use the public URL if they are ever split:
#   API_BASE_URL=https://events-api.aahaas.com/api
API_BASE_URL=http://127.0.0.1:8011/api

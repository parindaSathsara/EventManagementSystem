// EventSocial — Prisma schema (MySQL)
//
// Design notes:
//   * `cuid()` IDs everywhere — opaque, URL-safe, sortable enough for our needs.
//   * Soft FKs where the FE cares more about presence than strict referential
//     integrity at write time (e.g. linkedEventId on Reel can be nullable).
//   * Composite unique keys on join tables prevent dup follows / saves /
//     reactions without a separate index round-trip.
//
// To apply: `npx prisma migrate dev --name init` (dev) or
// `npx prisma migrate deploy` (prod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Users & artists
// -----------------------------------------------------------------------------

enum UserRole {
  customer
  artist
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?  // captured by the Complete Profile step on first login
  city         String?
  avatarUrl    String?
  role         UserRole @default(customer)
  // Sign-in bookkeeping for the super-admin console. Bumped on every
  // successful login; failures are counted from the ActivityLog instead.
  lastLoginAt  DateTime?
  loginCount   Int      @default(0)
  // Suspended by a super admin. A disabled account can't log in and any
  // token it still holds is rejected by the auth middleware.
  disabledAt   DateTime?
  // Which admin created this account from the console (null = self signup).
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artist          Artist?         @relation
  tickets         Ticket[]
  savedEvents     SavedEvent[]
  savedReels      SavedReel[]
  reactions       ReelReaction[]
  reposts         ReelRepost[]
  follows         Follow[]
  activities      ActivityLog[]

  @@index([role])
}

model Artist {
  id              String   @id @default(cuid())
  userId          String   @unique
  handle          String   @unique
  bio             String?  @db.Text
  category        String?  // DJ / Singer / Band — surfaced on the profile
  isVerified      Boolean  @default(false)
  // Preferred artists skip the manual approval queue — their reels/events
  // go live immediately on publish (per FR-S5b / FR-E4).
  isPreferred     Boolean  @default(false)
  followerCount   Int      @default(0)
  totalReelViews  Int      @default(0)
  totalEventTickets Int    @default(0)
  // Cosmetic — JSON blob for socials (instagram/spotify/youtube/etc).
  socialsJson     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         Event[]
  reels          Reel[]
  lineups        LineupEntry[]
  followers      Follow[]
  guestFollowers GuestFollow[]
}

// -----------------------------------------------------------------------------
// Events & tickets
// -----------------------------------------------------------------------------

enum EventStatus {
  draft
  published
  live
  cancelled
  ended
}

model Event {
  id                 String      @id @default(cuid())
  organizerArtistId  String
  title              String
  description        String?     @db.Text
  category           String      @default("Concert")
  coverColor         String      @default("#1a0a2e")
  coverImageUrl      String?
  // Flyer/banner used as the booking CTA on the company page.
  bannerImageUrl     String?
  // JSON array of extra flyer image URLs for the slider.
  flyersJson         String?     @db.Text
  // JSON blob of event socials: { facebook, instagram, tiktok }.
  socialsJson        String?     @db.Text
  // JSON array of free-form lineup artists entered by the manager:
  // [{ name, avatarUrl?, socials: { facebook, instagram, tiktok } }].
  // When set, this takes precedence over the relational `lineup` for display.
  lineupJson         String?     @db.Text
  // Third-party ticketing platform URL. When set, the guest "Buy Now" CTA
  // opens this link directly — in-app ticket selection is display-only.
  ticketUrl          String?     @db.Text
  startsAt           DateTime
  endsAt             DateTime
  // The start time is optional for the organizer (client feedback
  // 2026-08-10). When true, only the DAY is announced: `startsAt` holds that
  // day at noon (a neutral hour that can't drift into the previous/next day
  // in any timezone) and `endsAt` the end of that day, so the event sorts and
  // groups on the right date and never reads as "ended" mid-day. The guest UI
  // shows "Time revealed soon" instead of the placeholder hour.
  startTimeTba       Boolean     @default(false)
  timezone           String      @default("Asia/Colombo")
  venueName          String
  cityName           String
  addressLine        String?
  geoLat             Float?
  geoLng             Float?
  ageRestriction     String      @default("All ages")
  status             EventStatus @default(published)
  refundPolicy       String?     @db.Text
  cancellationPolicy String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organizer    Artist         @relation(fields: [organizerArtistId], references: [id], onDelete: Cascade)
  ticketTypes  TicketType[]
  tickets      Ticket[]
  savedBy      SavedEvent[]
  lineup       LineupEntry[]
  linkedReels  Reel[]         @relation("ReelLinkedEvent")

  @@index([organizerArtistId, status])
  @@index([startsAt])
  @@index([cityName])
}

model TicketType {
  id         String   @id @default(cuid())
  eventId    String
  name       String
  priceLabel String   // "LKR 4500" / "Free" — display string, kept simple
  priceCents Int      @default(0)
  currency   String   @default("LKR")
  total      Int
  remaining  Int
  createdAt  DateTime @default(now())

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([eventId])
}

enum TicketStatus {
  active
  used
  refunded
  cancelled
}

model Ticket {
  id           String       @id @default(cuid())
  eventId      String
  ticketTypeId String
  // Nullable: guest reservations have no account. Guest contact is captured
  // in the guest* fields below instead.
  userId       String?
  qrPayload    String       @unique
  status       TicketStatus @default(active)
  holderName   String
  guestName    String?
  guestPhone   String?
  guestEmail   String?
  issuedAt     DateTime     @default(now())
  usedAt       DateTime?

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([eventId])
}

model LineupEntry {
  id        String @id @default(cuid())
  eventId   String
  artistId  String
  order     Int    @default(0)

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([eventId, artistId])
  @@index([eventId])
}

// -----------------------------------------------------------------------------
// Reels & social
// -----------------------------------------------------------------------------

enum Visibility {
  public
  followers
  private
}

// Per FR-S5: every reel travels through a lifecycle. Preferred artists go
// from draft → published; non-preferred go draft → pending_approval → published.
enum ReelStatus {
  draft
  pending_approval
  published
  hidden
  removed
  rejected
}

model Reel {
  id                  String     @id @default(cuid())
  artistId            String
  caption             String     @db.Text
  musicTrackTitle     String?
  musicTrackArtistName String?
  linkedEventId       String?
  coverColor          String     @default("#1a0a2e")
  coverImageUrl       String?    // optional artist-picked thumbnail
  videoUrl            String?
  visibility          Visibility @default(public)
  status              ReelStatus @default(published)
  rejectionReason     String?    @db.Text
  views               Int        @default(0)
  publishedAt         DateTime   @default(now())
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  artist      Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  linkedEvent Event?         @relation("ReelLinkedEvent", fields: [linkedEventId], references: [id], onDelete: SetNull)
  tags        ReelTag[]
  reactions   ReelReaction[]
  reposts     ReelRepost[]
  saves       SavedReel[]

  @@index([artistId, publishedAt(sort: Desc)])
  @@index([linkedEventId])
}

model ReelTag {
  id     String @id @default(cuid())
  reelId String
  tag    String

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([reelId, tag])
  @@index([tag])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  artistId   String
  createdAt  DateTime @default(now())

  follower User   @relation(fields: [followerId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([followerId, artistId])
  @@index([artistId])
}

// Guest-first app: guests have no account, so their follows are keyed by an
// anonymous per-install device id. Kept in a separate table (not Follow) so
// the composite unique still guarantees one count bump per device — this is
// what keeps the organizer's followerCount honest.
model GuestFollow {
  id        String   @id @default(cuid())
  deviceId  String
  artistId  String
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([deviceId, artistId])
  @@index([artistId])
}

model SavedEvent {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
}

model SavedReel {
  id        String   @id @default(cuid())
  userId    String
  reelId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([userId])
}

model ReelReaction {
  id           String   @id @default(cuid())
  userId       String
  reelId       String
  reactionCode String   // fire | love | handsUp | wow | party
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  // One reaction per user per reel — code is overwritten on change.
  @@unique([userId, reelId])
  @@index([reelId, reactionCode])
}

model ReelRepost {
  id        String   @id @default(cuid())
  userId    String
  reelId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Push notifications
// -----------------------------------------------------------------------------

// One row per install. Keyed by the same anonymous `deviceId` the guest-first
// app already uses for GuestFollow, so "who follows this company" joins
// straight onto "where do we push" without an account.
//
// `expoPushToken` is the Expo Push Service address (ExponentPushToken[...]).
// It is NOT unique-constrained: reinstalling the app mints a new deviceId but
// FCM/APNs may hand back the same token, so registration explicitly detaches
// the token from any older device row instead of erroring on a dup.
model PushDevice {
  id            String   @id @default(cuid())
  deviceId      String   @unique
  expoPushToken String?  @db.VarChar(255)
  platform      String?  // ios | android
  appVersion    String?
  // Set when a manager is logged in on this install — lets us push to a user
  // across their devices, on top of the device-local guest follows.
  userId        String?
  // Guest-facing on/off switch (the Alerts screen toggle). Separate from OS
  // permission: revoking permission leaves the row, it just stops delivering.
  enabled       Boolean  @default(true)
  // Consecutive Expo delivery failures. Devices are retired at PUSH_MAX_FAILURES.
  failureCount  Int      @default(0)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expoPushToken])
  @@index([enabled])
  @@index([userId])
}

// Delivery ledger — the reason a guest never gets the same alert twice.
// `dedupeKey` is deterministic per (event, kind): "evt:<id>:published",
// "evt:<id>:T-3", … so the sweep can run every few minutes and stay idempotent.
model NotificationDelivery {
  id               String    @id @default(cuid())
  deviceId         String
  dedupeKey        String    @db.VarChar(160)
  eventId          String?
  // Expo push ticket id — resolved into a receipt a few minutes later, which
  // is where DeviceNotRegistered actually shows up for most dead tokens.
  ticketId         String?   @db.VarChar(191)
  status           String    @default("sent") // sent | failed
  error            String?   @db.Text
  sentAt           DateTime  @default(now())
  receiptCheckedAt DateTime?

  @@unique([deviceId, dedupeKey])
  @@index([sentAt])
  @@index([ticketId])
}

// -----------------------------------------------------------------------------
// Super-admin console: audit trail + traffic analytics
// -----------------------------------------------------------------------------

// Everything a person *did*: sign-ins (and failed attempts), sign-ups, event
// and profile changes, follows, reservations and every admin action. Written
// fire-and-forget by `lib/activity.js` — a logging hiccup never fails the
// request it describes.
//
// `action` is a dotted key ("auth.login", "event.update", "admin.user_create")
// so the console can filter by prefix. `actorEmail` is a snapshot: it survives
// the user being deleted and is the only identity a failed login has.
model ActivityLog {
  id          String   @id @default(cuid())
  action      String   @db.VarChar(64)
  actorUserId String?
  actorEmail  String?  @db.VarChar(191)
  actorRole   String?  @db.VarChar(16)
  targetType  String?  @db.VarChar(32)
  targetId    String?  @db.VarChar(64)
  // Human sentence shown in the feed: "Created event “Sunset Sessions”".
  summary     String?  @db.VarChar(255)
  metaJson    String?  @db.Text
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  source      String?  @db.VarChar(16) // web | app | api
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

// One row per view, written by POST /analytics/track from both clients.
//   kind = page     a website route was opened            (path set)
//        = event    an event page/screen was opened        (targetId = event id)
//        = artist   an organizer/artist profile was opened (targetId = artist id)
//        = app_open the mobile app was launched/resumed
// `visitorId` is the anonymous per-browser / per-install id, which is what
// makes "unique visitors" countable without accounts. Repeat views from the
// same visitor are collapsed server-side (see analytics/service.js).
model ViewEvent {
  id        String   @id @default(cuid())
  kind      String   @db.VarChar(16)
  targetId  String?  @db.VarChar(64)
  path      String?  @db.VarChar(255)
  visitorId String   @db.VarChar(80)
  userId    String?
  source    String   @db.VarChar(8) // web | app
  referrer  String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([kind, targetId, createdAt])
  @@index([visitorId, createdAt])
}

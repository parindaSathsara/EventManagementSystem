{
  "expo": {
    "name": "Stage",
    "slug": "event-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo/app-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Logo/stage.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aahaas.eventsocial",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.aahaas.eventsocial",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo/adaptive-foreground.png",
        "backgroundImage": "./assets/Logo/adaptive-background.png",
        "backgroundColor": "#8A0000"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/Logo/app-icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/Logo/notification-icon.png",
          "color": "#FF3B3B",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stage needs access to your photo library so you can upload event flyers and reel videos.",
          "cameraPermission": "Stage needs access to your camera to capture event flyers and record videos.",
          "microphonePermission": "Stage needs access to your microphone to capture audio with your reels."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "df709ac8-60e3-4f63-8ef4-9a8c61b5724d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/df709ac8-60e3-4f63-8ef4-9a8c61b5724d"
    }
  }
}
